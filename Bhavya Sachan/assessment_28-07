task 1 -----

WITH cte AS (
  select 
    p.category,
    p.sub_category,
    sum(t.sales_amount) as sub_cat_sales
  from dbo.ex_products p
  join dbo.ex_transactions t on t.product_id = p.product_id
  join dbo.ex_orders o on t.order_id = o.order_id
  where order_status not in ('Canceled', 'Unavailable')
  group by p.category, p.sub_category
)
select
  category,
  sub_category,
  sub_cat_sales,
  dense_rank() over (partition by category order by sub_cat_sales desc) as rnk,
  sub_cat_sales * 100.0 / sum(sub_cat_sales) over (partition by category) as contri_percent,
  sub_cat_sales * 100.0 / sum(sub_cat_sales) over ()  AS tot_percent
from cte
where sub_category = 'Appliances'
ORDER BY category, rnk;

